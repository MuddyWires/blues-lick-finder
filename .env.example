# Copy this file to .env and fill in your API key.
# .env is gitignored so your keys stay out of the repo.

OPENAI_API_KEY=your-openai-key-here

# Optional: DataImpulse residential proxy, used to avoid YouTube IP blocks
# when fetching transcripts. Leave blank to fetch without a proxy.
DATAIMPULSE_PROXY_HOST=
DATAIMPULSE_PROXY_PORT=
DATAIMPULSE_PROXY_USERNAME=
DATAIMPULSE_PROXY_PASSWORD=
